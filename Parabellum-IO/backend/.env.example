# ========================
# Server
# ========================
PORT=4000
# Browser origins allowed to call the API (comma-separated)
FRONTEND_URL=http://localhost:5173,http://localhost:4000

# ========================
# JWT Authentication (REQUIRED — the server will not start without it)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ========================
JWT_SECRET=your_jwt_secret_here

# Accounts with these e-mails become admins when they sign up / log in (comma-separated)
ADMIN_EMAIL=you@example.com

# ========================
# Email (Nodemailer / OTP)
# Gmail: turn on 2-Step Verification, create an App Password (16 characters) and use it as EMAIL_PASS.
# The server checks the SMTP login at start-up and prints "SMTP connection OK" or the exact error.
# ========================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# true for port 465 (SSL); leave empty for 587 (STARTTLS)
EMAIL_SECURE=
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password_here
# Optional "From" address (defaults to EMAIL_USER)
EMAIL_FROM=
# Set to false only for an internal SMTP relay that needs no login
EMAIL_AUTH=

# How the login code (OTP) is delivered:
#   auto   = e-mail it when EMAIL_USER/EMAIL_PASS are set; otherwise (or if the e-mail fails) show it on the login screen
#   email  = e-mail only — use this on a public server
#   screen = always show it on the login screen (demo / presentation)
#   both   = e-mail it and also show it on the screen
OTP_DELIVERY=auto

# ========================
# Data
# ========================
# Folder for the SQLite database (accounts, sessions, projects, findings). Keep it outside
# temporary/build folders so nothing is lost when the app restarts. Default: backend/data
DATA_DIR=

# ========================
# Projects
# ========================
# Folder that non-admin users may register local projects from. If empty, only admins can register server folders.
PROJECTS_ROOT=
# Max ZIP upload size in MB
MAX_UPLOAD_MB=200

# ========================
# Google Gemini AI (writes the RAG recommendations in the Final Report and "Get AI fix advice" on Risk Analysis)
# ========================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# ========================
# SonarQube
# ========================
SONARQUBE_URL=http://localhost:9000
SONARQUBE_TOKEN=your_sonarqube_token_here

# ========================
# Other security tools (optional — leave blank to use the defaults / PATH)
# ========================
# Semgrep rules: "auto" (needs internet) or a local folder of rules
SEMGREP_CONFIG=auto
# Snyk: install with `npm i -g snyk`, then `snyk auth` or set the token here
SNYK_TOKEN=
# Paths to the trivy / grype executables if they are not on PATH
TRIVY_PATH=
GRYPE_PATH=
# OWASP ZAP daemon API
ZAP_URL=http://localhost:8090
ZAP_API_KEY=

# ========================
# RAG Service (rag-service/app.py listens on port 5000; change with RAG_PORT)
# ========================
RAG_SERVICE_URL=http://localhost:5000
